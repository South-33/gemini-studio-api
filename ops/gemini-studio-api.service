[Unit]
Description=Gemini Studio API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/Gemini Studio API
ExecStart="%h/Gemini Studio API/.venv/bin/python" -m uvicorn main:app --host 127.0.0.1 --port 8000 --no-access-log --timeout-graceful-shutdown 15
Environment=PYTHONUNBUFFERED=1
Environment=GEMINI_IDLE_SECONDS=60
Restart=always
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
OOMPolicy=continue
MemoryHigh=2G
MemoryMax=3G
MemorySwapMax=512M
TasksMax=512
UMask=0077

[Install]
WantedBy=default.target
