[Unit]
Description=Gemini Studio API
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/gemini-studio-api
Environment="PATH=/home/YOUR_USERNAME/gemini-studio-api/venv/bin"
ExecStart=/home/YOUR_USERNAME/gemini-studio-api/venv/bin/python main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
