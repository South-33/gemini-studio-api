# Gemini Studio API - Environment Template

# Server
# PORT=8000
# NGROK_DOMAIN=your-subdomain.ngrok-free.app

# Worker pool
# PROVIDER=auto
# WORKER_COUNT=2

# Browser runtime
# HEADLESS=true
# BROWSER_CHANNEL=chromium
# BROWSER_TIMEOUT=480
# API_TIMEOUT_HEADROOM=30
# RECENT_REQUEST_LIMIT=200

# Headed split-window mode
# When HEADLESS=false and WORKER_COUNT>=2, this defaults to true.
# Set to false to keep multiple worker tabs in one window.
# HEADED_SPLIT_WINDOWS=true
# Layout: overlap (default) or tile
# HEADED_WINDOW_LAYOUT=overlap
# Per-window size used by overlap layout
# HEADED_WINDOW_WIDTH=1366
# HEADED_WINDOW_HEIGHT=768
# Overlap step per worker window
# HEADED_WINDOW_OFFSET_X=70
# HEADED_WINDOW_OFFSET_Y=45
# Virtual screen area used by tile layout
# HEADED_SCREEN_WIDTH=1920
# HEADED_SCREEN_HEIGHT=1080
# HEADED_SCREEN_LEFT=0
# HEADED_SCREEN_TOP=0

# Performance / stability
# LOW_MEMORY_MODE=true
# SLOW_VM_MODE=true
# WAIT_LOG_INTERVAL_SECONDS=10
# DEBUG_SCREENSHOTS=false

# Discord alerts (optional)
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# DISCORD_USER_ID=123456789012345678
# DISCORD_COOLDOWN=300
