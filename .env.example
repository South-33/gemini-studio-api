# Gemini Studio API - Configuration
# ====================================

# === REQUIRED ===
# Your static ngrok domain (claim free at dashboard.ngrok.com/cloud-edge/domains)
# NGROK_DOMAIN=your-domain.ngrok-free.app

# === OPTIONAL ===
# Number of concurrent browser tabs (default: 1)
# WORKER_COUNT=1

# Port for the API server (default: 8000)
# PORT=8000

# Provider mode: "auto", "aistudio", or "gemini-web" (default: auto)
# PROVIDER=auto

# Run browser without visible window (default: true)
# HEADLESS=true

# Block images/fonts to save RAM on low-memory servers (default: false)
# LOW_MEMORY_MODE=false