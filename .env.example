# Gemini Studio API - Configuration
# ====================================

# === PRODUCTION SETTINGS (GCP e2-micro) ===
# Use these for 1GB RAM servers

# Number of concurrent browser tabs (1 for low-memory, 2 if you have 2GB+)
# WORKER_COUNT=1

# Headless mode (MUST be true for servers without display)
# HEADLESS=true

# Low memory mode - blocks images/fonts to save RAM (recommended for e2-micro)
# LOW_MEMORY_MODE=true

# Port (GCP firewall needs to allow this)
PORT=8001

# === AUTHENTICATION ===
# Google Auth Cookies (JSON format or Base64 encoded JSON)
# Get these by logging into aistudio.google.com and exporting cookies
# Use a browser extension like "EditThisCookie" or "Cookie-Editor"
# GEMINI_COOKIES='[]'

# === LOCAL DEVELOPMENT ===
# Uncomment these for local testing with visible browser
# WORKER_COUNT=2
# HEADLESS=false
# LOW_MEMORY_MODE=false
