# Gemini Studio API - Configuration
# ====================================

# === BROWSER SETTINGS ===

# Run browser without visible window (default: false)
# Set to true after you've logged in once
# HEADLESS=true

# Number of concurrent browser tabs/workers (default: 1)
# Each worker is a separate Gemini Web tab that can handle one request at a time.
# Recommended: 2-4 workers for parallel processing. More workers = more RAM usage.
# WORKER_COUNT=2

# === SERVER SETTINGS ===

# Port for the API server (default: 8000)
# PORT=8000

# Max seconds to wait for one browser request before API timeout (default: 480)
# BROWSER_TIMEOUT=480

# Extra API-side timeout buffer above BROWSER_TIMEOUT to avoid edge races (default: 30)
# API_TIMEOUT_HEADROOM=30

# Number of recent request traces kept in memory for /v1/diagnostics (default: 200)
# RECENT_REQUEST_LIMIT=200

# === PERFORMANCE SETTINGS ===

# Block images/fonts to save RAM on low-memory servers (default: true)
# LOW_MEMORY_MODE=true

# Use JavaScript clicks for slow VMs (default: true)
# SLOW_VM_MODE=true

# Wait loop telemetry frequency in seconds (default: 10)
# WAIT_LOG_INTERVAL_SECONDS=10

# Mark as stuck when generation runs with zero output for this many seconds (default: 45)
# STUCK_EMPTY_SECONDS=45

# Mark as stuck when generation has no output progress for this many seconds (default: 90)
# STUCK_NO_PROGRESS_SECONDS=90

# After Stop->Send transition, allow this many seconds for terminal UI to settle (default: 5)
# TERMINAL_GRACE_SECONDS=5

# Keep tabs warm/recover stale idle state in headless mode (default: false)
# ENABLE_TAB_KEEPALIVE=true

# Keepalive loop interval in seconds (default: 75)
# TAB_KEEPALIVE_INTERVAL=75

# Only run keepalive maintenance when worker idle time exceeds this threshold (default: 300)
# TAB_IDLE_RECOVER_SECONDS=300

# === DISCORD NOTIFICATIONS ===
# Get notified on your phone when errors occur

# Discord webhook URL (required for notifications)
# Create: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# Your Discord user ID for @mentions (optional - enables phone push notifications)
# Get your ID: Enable Developer Mode in Discord, right-click yourself, Copy ID
# DISCORD_USER_ID=123456789012345678

# Cooldown between same error notifications in seconds (default: 300 = 5 min)
# DISCORD_COOLDOWN=300
