# Gemini Studio API - Environment Template

# Server
# PORT=8000
# NGROK_DOMAIN=your-subdomain.ngrok-free.app

# Browser runtime
# HEADLESS=true
# BROWSER_CHANNEL=chromium
# BROWSER_TIMEOUT=480
# API_TIMEOUT_HEADROOM=30
# QUEUE_TIMEOUT=1800
# RECENT_REQUEST_LIMIT=200

# Optional CSS zoom applied to page content in headed mode (1.0 = no zoom)
# HEADED_PAGE_ZOOM=1.0

# Performance / stability
# LOW_MEMORY_MODE=true
# ENABLE_PROMPT_FILE_UPLOAD=true
# PROMPT_FILE_UPLOAD_THRESHOLD=1500

# Discord alerts (optional)
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# DISCORD_USER_ID=123456789012345678
# DISCORD_COOLDOWN=300
